# Postgres connection URL. Required.
DATABASE_URL=postgresql://concrisk:localdev@localhost:5432/concrisk

# Environment tag: dev | prod
ENV=dev

# SEC EDGAR requires a descriptive User-Agent per their fair-use policy.
# Format: "Your Name your.email@example.com". Required before Phase 1 ETL runs.
SEC_USER_AGENT=

# OpenFIGI API key. Optional (used in Phase 1); higher rate limit if set.
OPENFIGI_API_KEY=

# Anthropic API key + model. Used in Phase 5 chatbot.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# API key clients send in the X-API-Key header. Used in Phase 3.
API_KEY=
